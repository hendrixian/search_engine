# Ignore Python cache files
__pycache__
*.pyc
*.pyo
*.pyd

# Ignore virtual environment folders
venv/
.envrc

# Ignore logs and temporary files
*.log
*.tmp
*.swp

# Ignore model and cache directories
models/
Docker/model_cache/
.cache/
.huggingface/

# Ignore data directories (if not needed in container)
data/
papers/
passages/

# Ignore git files
.git
.gitignore

# Ignore backups
*.bak
*.old

# Ignore MinIO client
mc.exe